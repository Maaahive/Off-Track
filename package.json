{
  "name": "offtrack",
  "version": "1.0.0",
  "description": "OffTrack — A lightweight floating frosted-glass desktop music player streaming YouTube audio with Spotify integration",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "postinstall": "node scripts/ensure-ytdlp.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "chalk": "^5.3.0",
    "conf": "^12.0.0",
    "dotenv": "^16.4.7",
    "node-fetch": "^3.3.2",
    "open": "^10.1.0",
    "spotify-uri": "^4.1.0",
    "spotify-url-info": "^3.3.0",
    "spotify-web-api-node": "^5.0.2",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mahi.offtrack",
    "productName": "OffTrack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OffTrack"
    }
  }
}
